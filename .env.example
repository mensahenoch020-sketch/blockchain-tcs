# Local development only. Do not expose Hardhat RPC or this database URL publicly.
DATABASE_URL=postgresql://postgres@127.0.0.1:55432/credentials
PORT=3000
APP_ORIGIN=http://localhost:5173
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
LOCAL_UNLOCKED_SIGNERS=true
CONFIRMATIONS=1
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=
DEMO_ISSUER_EMAIL=issuer@example.test
DEMO_ISSUER_PASSWORD=
# For Sepolia set CHAIN_ID=11155111, set RPC_URL to SEPOLIA_RPC_URL,
# disable LOCAL_UNLOCKED_SIGNERS, set CONFIRMATIONS=2 and provision funded wallets.
SEPOLIA_RPC_URL=
ADMIN_PRIVATE_KEY=
ISSUER_PRIVATE_KEYS=
# Set true when serving over HTTPS.
COOKIE_SECURE=false
